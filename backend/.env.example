DB_URL=mongodb://localhost/url_shortener
PORT=3000
SECRET_KEY=replace-with-a-random-48-char-hex-string
PUBLIC_BASE_URL=https://api.linkblick.com
FRONTEND_URL=https://linkblick.com

# Set this to "production" when deploying. It enables the Secure flag on
# cookies (refresh token + CSRF token) and redirects any plain-HTTP request
# to HTTPS. Leave unset/"development" for local dev over http://localhost,
# since browsers reject Secure cookies on non-HTTPS origins.
NODE_ENV=development

# SameSite for the refresh/CSRF cookies: "lax" (default) works when the
# frontend and this API share a registrable domain (e.g. app.example.com +
# api.example.com). If they're on genuinely different domains (e.g. a
# Vercel frontend + a Render/Railway API), set this to "none" — the browser
# treats that as cross-site and won't send Lax/Strict cookies on fetch/XHR
# at all. "none" always forces the Secure flag (required by spec), so it
# needs NODE_ENV=production / real HTTPS to actually work.
COOKIE_SAME_SITE=lax

# ─── Account lockout ──────────────────────────────────────────────────────────
# Locks an account (independent of IP) after this many consecutive wrong
# passwords, for this many minutes. Separate from the IP-based rate limiter
# in server.js, which resets per IP and wouldn't stop an attacker spreading
# guesses across many IPs.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional — Google Sign-In (leave blank to disable the Google login button)
GOOGLE_CLIENT_ID=

# ─── Access / refresh tokens ─────────────────────────────────────────────────
# ACCESS_TOKEN_DURATION: how long a Bearer access token stays valid.
# REFRESH_TOKEN_DAYS: how long a refresh token stays valid before it must
# be used to sign in again from scratch.
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DAYS=30

# ─── Outgoing email (forgot / reset password) ────────────────────────────────
# Leave these blank during local development — the reset link will just be
# printed to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
