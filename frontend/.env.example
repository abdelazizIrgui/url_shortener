# ─── Backend API URL ─────────────────────────────────────────────────────────
# Dev:        http://localhost:3000
# Production: https://api.linkblick.com
VITE_API_URL=https://api.linkblick.com

# ─── Google OAuth Client ID (optional) ───────────────────────────────────────
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost:5173 (dev) and https://linkblick.com (prod) to
# "Authorised JavaScript origins" in the OAuth client.
# Leave blank to disable the Google Login button.
VITE_GOOGLE_CLIENT_ID=
